# ------------------------------------------------------------------
# Copy this file, rename the copy to ".env.local" and fill it in.
# The website works without any of these — orders are then printed in
# the terminal where `npm run dev` is running instead of emailed.
# ------------------------------------------------------------------

# 1) ORDER + CONTACT EMAILS (free account at https://resend.com)
RESEND_API_KEY=
# Where new orders and messages are sent (your inbox)
ORDER_NOTIFY_EMAIL=you@example.com
# The "from" address. Use onboarding@resend.dev until you verify your own domain.
EMAIL_FROM="Icoa-Uru <onboarding@resend.dev>"

# 2) CARD PAYMENTS (optional, https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Set to "true" once STRIPE_SECRET_KEY is filled in to show the card option at checkout
NEXT_PUBLIC_STRIPE_ENABLED=false

# 3) Your live website address (used for links in emails and Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4) WEBSITE EDITOR FROM OTHER DEVICES (optional)
# The editor (/admin) always works on the computer that runs the website.
# To also use it from another laptop or phone on the same WiFi, set a password here.
ADMIN_PASSWORD=
